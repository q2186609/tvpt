# 复制为 .env 后填写。不要把 .env 提交到版本库。
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# qBittorrent WebUI 账号。linuxserver 镜像首次启动会在日志里打印临时密码,
# 在 WebUI -> Tools -> Options -> Web UI 改成固定密码后填在这里。
QB_USERNAME=admin
QB_PASSWORD=

# Prowlarr -> Settings -> General -> API Key
PROWLARR_API_KEY=

# Stremio 客户端访问 seedstrem 的地址, 填 NAS 的局域网 IP, 不能用 localhost
# 安装地址是 ${TVPT_EXTERNAL_URL}/stremio/manifest.json
TVPT_EXTERNAL_URL=http://192.168.1.10:8081

# Prowlarr 出网代理。部分 PT 站在 Cloudflare 后面, 从国内直连时 TLS 握手
# 会被间歇重置(实测直连成功率约 30%, 走 HTTP/3 是 100%, 但 Prowlarr 只走 TCP),
# 因此需要代理。没有代理需求时设 false。
# 注意: 代理主机必须是 Prowlarr 容器能访问到的地址, 不能用 127.0.0.1。
PROWLARR_PROXY_ENABLED=false
PROWLARR_PROXY_HOST=192.168.1.10
PROWLARR_PROXY_PORT=7890
PROWLARR_PROXY_TYPE=http
