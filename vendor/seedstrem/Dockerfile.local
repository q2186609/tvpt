# 本地重建: 与 Dockerfile.patch 相同, 但前端依赖走 npmmirror, 便于国内构建。
# 用法(在 vendor/seedstrem 目录): docker build --network=host -f Dockerfile.local -t tvpt/seedstrem:seqfix .

FROM node:22-alpine AS web
WORKDIR /src/web
RUN npm config set registry https://registry.npmmirror.com
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM golang:1.26-alpine AS build
WORKDIR /src
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=sum.golang.google.cn
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/web/dist ./web/dist
ARG VERSION=poc
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /seedstrem ./cmd/seedstrem

FROM ghcr.nju.edu.cn/kipsilabs/seedstrem:latest
COPY --from=build /seedstrem /seedstrem
