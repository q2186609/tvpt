+// downloadToken derives a short, stable, URL-safe identifier from a
+// Prowlarr download link. It stands in for the infohash in a play URL when
+// the infohash is not resolved until play time; it also keys the pending
+// release cache so the play handler can recover the release's title.
+func downloadToken(downloadURL string) string {
+	sum := sha256.Sum256([]byte(downloadURL))
+	return hex.EncodeToString(sum[:12])
+}
