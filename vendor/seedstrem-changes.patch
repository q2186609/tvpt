+// ResolveDownloadURL completes a deferred magnet-less result: it fetches
+// the .torrent, derives the infohash and announce trackers, and returns a
+// playable magnet plus the raw torrent bytes. It reports an error when the
+// release carries no download URL (already resolved, or unresolvable).
+func (c *Client) ResolveDownloadURL(ctx context.Context, res Result) (magnet string, raw []byte, err error) {
+	if res.DownloadURL == "" {
+		return "", nil, fmt.Errorf("prowlarr: release has no download URL")
+	}
+	hash, name, trackers, rawBytes, err := c.fetchTorrentHash(ctx, res.DownloadURL)
+	if err != nil {
+		return "", nil, err
+	}
+	title := res.Title
+	if title == "" {
+		title = name
+	}
+	return synthesizeMagnet(hash, title, trackers), rawBytes, nil
+}
